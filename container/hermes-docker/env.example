# Copy token values into ~/.hermes/.env (default profile), not into this file.
# ~/.hermes/.env is ignored by git.

# Preferred for GitHub CLI in the Docker backend:
GH_TOKEN=
# Alternative also supported by gh:
GITHUB_TOKEN=

# Optional: used by container/hermes-docker/setup.sh when setting git identity.
HERMES_GIT_USER_NAME=Nathan Schott
HERMES_GIT_USER_EMAIL=
