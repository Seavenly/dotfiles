# Fast, deterministic shell startup. Downloads and installs belong to dotfiles install.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
[[ "$(uname -s)" == Darwin ]] && export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export DOTFILES_ROOT="$(dotfiles-root)"
source "$DOTFILES_ROOT/internal/shell/paths.sh"
dotfiles_load_paths

export EDITOR="nvr -l"
export VISUAL="nvr --remote-wait +'set bufhidden=wipe'"

ANTIDOTE_HOME="$XDG_CACHE_HOME/antidote"
if [[ -r "$XDG_DATA_HOME/antidote/antidote.zsh" ]]; then
  source "$XDG_DATA_HOME/antidote/antidote.zsh"
  [[ -r "$XDG_CACHE_HOME/antidote/zsh_plugins.zsh" ]] && source "$XDG_CACHE_HOME/antidote/zsh_plugins.zsh"
fi

autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"

HISTSIZE=50000
SAVEHIST=50000
HISTFILE="$XDG_STATE_HOME/zsh/history"
setopt append_history share_history hist_ignore_space hist_ignore_all_dups
setopt hist_save_no_dups hist_ignore_dups hist_find_no_dups

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu select
bindkey '^[[Z' reverse-menu-complete

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd z)"
fi

sesh-connect() {
  {
    # ZLE widgets do not guarantee terminal-backed stdin after an interactive
    # picker exits. tmux attach requires it, so restore the controlling TTY.
    exec </dev/tty
    exec <&1
    local project
    project="$(project-selector)" || return
    zle reset-prompt >/dev/null 2>&1 || true
    [[ -n "$project" ]] && sesh connect "$project"
  }
}
zle -N sesh-connect
bindkey '^a' sesh-connect

source "$HOME/.local/bin/nvim-remote-shell"
source "$DOTFILES_ROOT/config/zsh/aliases.zsh"
[[ -r "$XDG_CONFIG_HOME/dotfiles/aliases.local.zsh" ]] && source "$XDG_CONFIG_HOME/dotfiles/aliases.local.zsh"
[[ -r "$XDG_CONFIG_HOME/dotfiles/private.zsh" ]] && source "$XDG_CONFIG_HOME/dotfiles/private.zsh"

if command -v oh-my-posh >/dev/null 2>&1; then
  eval "$(oh-my-posh init zsh --config "$DOTFILES_ROOT/config/zsh/onehalf.minimal.omp.yaml")"
fi
