{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.runtime-runner-status.v1.schema.json",
  "title": "flow.runtime-runner-status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "runs",
    "delegates",
    "operations",
    "pending_commands",
    "errors"
  ],
  "properties": {
    "schema": { "const": "flow.runtime-runner-status/v1" },
    "state": { "enum": ["idle", "running", "stopped"] },
    "runs": { "$ref": "#/$defs/runs" },
    "delegates": { "$ref": "#/$defs/capacity" },
    "operations": { "$ref": "#/$defs/capacity" },
    "pending_commands": { "type": "integer", "minimum": 0 },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "reported", "suppressed", "last"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "reported": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "last": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "capacity", "available"],
      "properties": {
        "active": { "type": "integer", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 1 },
        "available": { "type": "integer", "minimum": 0 }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "executing", "waiting", "suspended", "retained"],
      "properties": {
        "active": { "type": "integer", "minimum": 0 },
        "executing": { "type": "integer", "minimum": 0 },
        "waiting": { "type": "integer", "minimum": 0 },
        "suspended": { "type": "integer", "minimum": 0 },
        "retained": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 }
      }
    }
  }
}
