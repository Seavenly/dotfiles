{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.task-settlement-proof.v1.schema.json",
  "title": "flow.task-settlement-proof/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "flow.task-settlement-proof/v1"
    },
    "classification": {
      "const": "exact_task_correlation"
    },
    "descriptor_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminal_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "native_session": {
      "type": "string",
      "minLength": 1
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "description_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "launch_comparison_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configuration_watermark": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ordered_inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema",
    "classification",
    "descriptor_digest",
    "input_sha256",
    "output_contract_digest",
    "stdout_sha256",
    "terminal_receipt_digest",
    "native_session",
    "record_sha256"
  ]
}
