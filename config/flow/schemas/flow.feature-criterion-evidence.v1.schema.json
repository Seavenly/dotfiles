{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.feature-criterion-evidence.v1.schema.json",
  "title": "flow.feature-criterion-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "criteria"],
  "properties": {
    "schema": { "const": "flow.feature-criterion-evidence/v1" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "expected", "kind", "target"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "maxLength": 1048576 },
          "kind": { "const": "git_file_equals" },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^/\\\\-][^\\\\]*$"
          }
        }
      }
    }
  }
}
