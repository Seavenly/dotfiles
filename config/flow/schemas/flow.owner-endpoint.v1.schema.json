{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.owner-endpoint.v1.schema.json",
  "title": "flow.owner-endpoint/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "owner_token",
    "pid",
    "process_identity",
    "process_start_identity",
    "authority_directory",
    "endpoint_path",
    "socket_path",
    "started_at"
  ],
  "properties": {
    "schema": { "const": "flow.owner-endpoint/v1" },
    "version": { "const": 1 },
    "owner_token": { "type": "string", "minLength": 8 },
    "pid": { "type": "integer", "minimum": 1 },
    "process_identity": { "type": "string", "minLength": 1 },
    "process_start_identity": { "type": "string", "minLength": 1 },
    "authority_directory": { "type": "string", "minLength": 1 },
    "endpoint_path": { "type": "string", "minLength": 1 },
    "socket_path": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 }
  }
}
