{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.git-candidate-commit-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effect_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "old_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "flow.git-candidate-commit-receipt/v1"
    },
    "workspace": {
      "type": "object"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "proof": {
      "const": "exact_local_ref_cas"
    }
  },
  "required": [
    "effect_id",
    "idempotency_key",
    "attempt_id",
    "old_commit_sha",
    "commit_sha",
    "tree_sha",
    "ref",
    "schema",
    "workspace",
    "record_sha256",
    "proof"
  ]
}
