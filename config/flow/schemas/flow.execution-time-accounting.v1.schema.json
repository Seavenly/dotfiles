{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.execution-time-accounting.v1.schema.json",
  "title": "flow.execution-time-accounting/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "wall_elapsed",
    "active_execution",
    "fresh_observation_boundaries",
    "uncertainty",
    "authority"
  ],
  "properties": {
    "schema": { "const": "flow.execution-time-accounting/v1" },
    "wall_elapsed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includes", "same_boot_source", "cross_boot_source"],
      "properties": {
        "includes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "same_boot_source": { "const": "suspend_excluding_monotonic" },
        "cross_boot_source": { "const": "wall_clock" }
      }
    },
    "active_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "excludes"],
      "properties": {
        "definition": { "const": "sum_of_admitted_invocation_intervals" },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "fresh_observation_boundaries": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "straddling_decision",
        "missing_or_invalid_fact"
      ],
      "properties": {
        "representation": { "const": "lower_upper_bounds" },
        "straddling_decision": { "const": "block_new_admission" },
        "missing_or_invalid_fact": { "const": "block_new_admission" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "expansion", "timer_ownership_transfer"],
      "properties": {
        "limits": { "const": "exact_confirmed_run_and_attempt_bounds" },
        "expansion": {
          "const": "exact_human_checkpoint_or_revision_authority"
        },
        "timer_ownership_transfer": { "const": "forbidden" }
      }
    }
  }
}
