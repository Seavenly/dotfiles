{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.review-preparation-facts.v1.schema.json",
  "title": "flow.review-preparation-facts/v1",
  "description": "Canonical authority-derived facts for preparing one exact sealed local review candidate. Operation inputs and provider payloads are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "source_run",
    "workspace",
    "route",
    "catalog",
    "operation",
    "validator",
    "time_facts",
    "authority_facts",
    "owner_authorities",
    "authority_watermarks",
    "facts_digest"
  ],
  "properties": {
    "schema": { "const": "flow.review-preparation-facts/v1" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "source_run": { "$ref": "#/$defs/sourceRun" },
    "workspace": { "$ref": "#/$defs/workspace" },
    "route": { "$ref": "#/$defs/route" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "operation": { "$ref": "#/$defs/contracts" },
    "validator": { "$ref": "#/$defs/validators" },
    "time_facts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "flow.time-fact.v1.schema.json" },
      "allOf": [
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "wall_clock" } } } },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "suspend_excluding_monotonic" } } } },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "boot" } } } },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "clock_source" } } } }
      ]
    },
    "authority_facts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/authorityFact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["authority_id", "authority_contract"],
            "properties": {
              "authority_id": { "const": "contract:facts" },
              "authority_contract": { "const": "flow.contract-authority/v1" }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["authority_id", "authority_contract"],
            "properties": {
              "authority_id": { "const": "generation:facts" },
              "authority_contract": { "const": "flow.subject-generation/v1" }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["authority_id", "authority_contract"],
            "properties": {
              "authority_id": { "const": "resource:facts" },
              "authority_contract": { "const": "flow.resource-authority/v1" }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["authority_id", "authority_contract"],
            "properties": {
              "authority_id": { "const": "route:facts" },
              "authority_contract": { "const": "flow.route-authority/v1" }
            }
          }
        }
      ]
    },
    "owner_authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "review", "workspace"],
      "properties": {
        "run": { "$ref": "#/$defs/runAuthorityFact" },
        "review": { "$ref": "#/$defs/reviewAuthorityFact" },
        "workspace": { "$ref": "#/$defs/workspaceAuthorityFact" }
      }
    },
    "authority_watermarks": { "$ref": "#/$defs/authorityWatermarks" },
    "facts_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "version"],
      "properties": {
        "schema": { "const": "flow.registered-authority/v1" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_fingerprint",
        "lifecycle_generation",
        "authority_watermark"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "candidate_fingerprint": { "$ref": "#/$defs/digest" },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_watermark": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "phase",
        "candidate_id",
        "candidate_fingerprint",
        "authority_watermark"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "succeeded" },
        "candidate_id": { "type": "string", "minLength": 1 },
        "candidate_fingerprint": { "$ref": "#/$defs/digest" },
        "authority_watermark": { "$ref": "#/$defs/digest" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "generation",
        "mutation_epoch",
        "fingerprint",
        "authority_watermark"
      ],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mutation_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "authority_watermark": { "$ref": "#/$defs/digest" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "configuration_watermark", "comparison_key", "bindings"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "configuration_watermark": { "$ref": "#/$defs/digest" },
        "comparison_key": { "$ref": "#/$defs/digest" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/routeBinding" }
        }
      }
    },
    "routeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "route", "description"],
      "properties": {
        "card_id": { "type": "string", "minLength": 1 },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "configuration_watermark", "description_digest", "launch_comparison_key"],
          "properties": {
            "agent_id": { "type": "string", "minLength": 1 },
            "configuration_watermark": { "$ref": "#/$defs/digest" },
            "description_digest": { "$ref": "#/$defs/digest" },
            "launch_comparison_key": { "$ref": "#/$defs/digest" }
          }
        },
        "description": { "$ref": "#/$defs/routeDescription" }
      }
    },
    "routeDescription": {
      "type": "object",
      "required": ["schema", "description_digest", "comparison_keys", "watermark"],
      "properties": {
        "schema": { "enum": ["drovr.delegated-agent-description/v1", "flow.execution-description/v1"] },
        "description_digest": { "$ref": "#/$defs/digest" },
        "comparison_keys": {
          "type": "object",
          "required": ["launch", "effective_authority"],
          "properties": {
            "launch": { "$ref": "#/$defs/digest" },
            "effective_authority": { "$ref": "#/$defs/digest" }
          }
        },
        "watermark": {
          "type": "object",
          "required": ["content_sha256"],
          "properties": {
            "content_sha256": { "$ref": "#/$defs/digest" }
          }
        }
      },
      "additionalProperties": true
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^flow\\.contract-catalog/v1@[1-9][0-9]*$"
        },
        "fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts"],
      "properties": {
        "contracts": {
          "type": "array",
          "minItems": 1,
          "allOf": [
            { "contains": { "const": "flow.operation/review-record/v1" } }
          ],
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "validators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts"],
      "properties": {
        "contracts": {
          "type": "array",
          "minItems": 2,
          "allOf": [
            { "contains": { "const": "flow.validator/operation-receipt/v1" } },
            { "contains": { "const": "flow.validator/review-result/v1" } }
          ],
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "authorityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority_id",
        "authority_contract",
        "provider_identity",
        "watermark",
        "generation",
        "legal_actions"
      ],
      "properties": {
        "schema": { "const": "flow.authority-fact/v1" },
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_contract": { "type": "string", "minLength": 1 },
        "provider_identity": { "$ref": "#/$defs/providerIdentity" },
        "watermark": {
          "anyOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "generation": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "legal_actions": { "type": "array" }
      },
      "anyOf": [
        { "properties": { "watermark": { "$ref": "#/$defs/digest" } } },
        { "properties": { "generation": { "type": "integer" } } }
      ]
    },
    "ownerAuthorityFactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority_id",
        "authority_contract",
        "provider_identity",
        "watermark",
        "watermark_domain",
        "subject_id",
        "disposition",
        "generation",
        "facts",
        "legal_actions"
      ],
      "properties": {
        "schema": { "const": "flow.authority-fact/v1" },
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_contract": { "type": "string", "minLength": 1 },
        "provider_identity": { "$ref": "#/$defs/providerIdentity" },
        "watermark": { "$ref": "#/$defs/digest" },
        "watermark_domain": { "enum": ["run", "review", "workspace"] },
        "subject_id": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "minLength": 1 },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "facts": { "type": "object" },
        "legal_actions": { "type": "array" }
      }
    },
    "runOwnerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "phase",
        "candidate_id",
        "candidate_fingerprint",
        "sequence",
        "current_revision",
        "bundle_digest",
        "projection_digest"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "succeeded" },
        "candidate_id": { "type": "string", "minLength": 1 },
        "candidate_fingerprint": { "$ref": "#/$defs/digest" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "current_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ordinal", "plan_fingerprint"],
          "properties": {
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "plan_fingerprint": { "$ref": "#/$defs/digest" }
          }
        },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "projection_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reviewOwnerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_fingerprint",
        "workspace_subject_id",
        "workspace_generation",
        "workspace_fingerprint",
        "projection_digest"
      ],
      "properties": {
        "candidate_fingerprint": { "$ref": "#/$defs/digest" },
        "workspace_subject_id": { "type": "string", "minLength": 1 },
        "workspace_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workspace_fingerprint": { "$ref": "#/$defs/digest" },
        "projection_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "workspaceOwnerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "git_commit_sha",
        "git_tree_sha",
        "git_ref",
        "git_clean",
        "mutation_epoch",
        "taint_status",
        "claims_digest",
        "projection_digest"
      ],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/digest" },
        "git_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "git_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "git_ref": { "type": "string", "minLength": 1 },
        "git_clean": { "const": true },
        "mutation_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "taint_status": { "const": "clear" },
        "claims_digest": { "$ref": "#/$defs/digest" },
        "projection_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "runAuthorityFact": {
      "allOf": [
        { "$ref": "#/$defs/ownerAuthorityFactBase" },
        {
          "type": "object",
          "properties": {
            "authority_id": { "const": "RunAuthority" },
            "authority_contract": { "const": "flow.run-projection/v1" },
            "provider_identity": {
              "type": "object",
              "properties": {
                "id": { "const": "flow.production.run-authority" },
                "version": { "const": "1" }
              }
            },
            "watermark_domain": { "const": "run" },
            "disposition": { "const": "succeeded" },
            "facts": { "$ref": "#/$defs/runOwnerFacts" }
          }
        }
      ]
    },
    "reviewAuthorityFact": {
      "allOf": [
        { "$ref": "#/$defs/ownerAuthorityFactBase" },
        {
          "type": "object",
          "properties": {
            "authority_id": { "const": "ReviewAuthority" },
            "authority_contract": { "const": "work.review/v1" },
            "provider_identity": {
              "type": "object",
              "properties": {
                "id": { "const": "flow.production.review-authority" },
                "version": { "const": "1" }
              }
            },
            "watermark_domain": { "const": "review" },
            "disposition": { "const": "sealed" },
            "facts": { "$ref": "#/$defs/reviewOwnerFacts" }
          }
        }
      ]
    },
    "workspaceAuthorityFact": {
      "allOf": [
        { "$ref": "#/$defs/ownerAuthorityFactBase" },
        {
          "type": "object",
          "properties": {
            "authority_id": { "const": "WorkspaceAuthority" },
            "authority_contract": { "const": "work.workspace/v1" },
            "provider_identity": {
              "type": "object",
              "properties": {
                "id": { "const": "flow.production.workspace-authority" },
                "version": { "const": "1" }
              }
            },
            "watermark_domain": { "const": "workspace" },
            "disposition": { "const": "retained_for_handoff" },
            "facts": { "$ref": "#/$defs/workspaceOwnerFacts" }
          }
        }
      ]
    },
    "authorityWatermarks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "source_run",
        "workspace",
        "route",
        "resource",
        "contract",
        "generation",
        "catalog",
        "operation",
        "validator",
        "time"
      ],
      "properties": {
        "candidate": { "$ref": "#/$defs/digest" },
        "source_run": { "$ref": "#/$defs/digest" },
        "workspace": { "$ref": "#/$defs/digest" },
        "route": { "$ref": "#/$defs/digest" },
        "resource": { "$ref": "#/$defs/digest" },
        "contract": { "$ref": "#/$defs/digest" },
        "generation": { "$ref": "#/$defs/digest" },
        "catalog": { "$ref": "#/$defs/digest" },
        "operation": { "$ref": "#/$defs/digest" },
        "validator": { "$ref": "#/$defs/digest" },
        "time": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
