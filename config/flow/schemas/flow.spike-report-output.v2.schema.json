{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.spike-report/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question_id",
    "answer",
    "assurance",
    "citations",
    "findings",
    "residual_gaps",
    "research_evidence_digest"
  ],
  "properties": {
    "schema": {
      "const": "flow.spike-report/v2"
    },
    "question_id": {
      "type": "string",
      "maxLength": 100
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "assurance": {
      "const": "lower"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "digest"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 80
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "residual_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "research_evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
