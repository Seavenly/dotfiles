{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.feature-critique-output.v1.schema.json",
  "title": "flow.feature-critique-output/v1",
  "description": "Canonical independent feature critique carried inside the registered delegate-evidence envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_critique", "observation", "schema"],
  "properties": {
    "schema": { "const": "flow.delegate-evidence/v1" },
    "observation": {
      "type": "string",
      "maxLength": 2048
    },
    "feature_critique": {
      "$ref": "#/$defs/feature-critique"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "feature-critique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_digest",
        "criteria",
        "findings",
        "predecessor_evidence_digest",
        "schema",
        "task_inputs_digest"
      ],
      "properties": {
        "schema": { "const": "flow.feature-critique-output/v1" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "predecessor_evidence_digest": { "$ref": "#/$defs/digest" },
        "task_inputs_digest": { "$ref": "#/$defs/digest" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "evidence",
              "evidence_digest",
              "verdict"
            ],
            "properties": {
              "criterion": { "type": "string", "minLength": 1 },
              "evidence_digest": { "$ref": "#/$defs/digest" },
              "verdict": { "enum": ["failed", "passed"] },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["expected", "kind", "target"],
                "properties": {
                  "kind": { "const": "git_file_equals" },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[^/\\\\-][^\\\\]*$"
                  },
                  "expected": {
                    "type": "string",
                    "maxLength": 1048576
                  }
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "detail", "finding_id", "summary"],
            "properties": {
              "classification": { "enum": ["blocking", "non_blocking"] },
              "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "detail": { "type": "string", "minLength": 1, "maxLength": 8192 },
              "finding_id": {
                "type": "string",
                "pattern": "^finding:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
