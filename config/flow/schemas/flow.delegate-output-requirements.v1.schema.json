{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.delegate-output-requirements.v1.schema.json",
  "title": "flow.delegate-output-requirements/v1",
  "description": "Canonical output schemas and independent validator contracts selected by the caller.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format", "schemas", "validator_contracts"],
  "properties": {
    "schema": { "const": "flow.delegate-output-requirements/v1" },
    "format": { "const": "canonical-json" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "validator_contracts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
