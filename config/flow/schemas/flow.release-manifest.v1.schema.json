{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.release-manifest.v1.schema.json",
  "title": "flow.release-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "release_id",
    "implementation",
    "scope",
    "normal_use_authorized",
    "remote_mutations_authorized",
    "not_authorized_before_issue",
    "scope_expansion",
    "dark_opt_in",
    "supported_routes",
    "disabled_routes",
    "deferred_scope",
    "sacrificial_followups"
  ],
  "properties": {
    "schema": { "const": "flow.release-manifest/v1" },
    "version": { "const": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "implementation": { "const": "flow-runtime/v1" },
    "scope": { "const": "dark_sacrificial" },
    "normal_use_authorized": { "const": false },
    "remote_mutations_authorized": { "const": false },
    "not_authorized_before_issue": { "const": 50 },
    "scope_expansion": { "const": "new_manifest_and_evidence_required" },
    "dark_opt_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "release_id", "purpose", "routes"],
      "properties": {
        "schema": { "const": "flow.dark-opt-in/v1" },
        "release_id": { "type": "string", "minLength": 1 },
        "purpose": { "const": "sacrificial_qualification" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        }
      }
    },
    "supported_routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/supportedRoute" }
    },
    "disabled_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/disabledRoute" }
    },
    "deferred_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sacrificial_followups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "status"],
        "properties": {
          "issue": { "type": "integer", "minimum": 1 },
          "status": { "const": "not_run" }
        }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "mode"],
      "properties": {
        "flow": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 }
      }
    },
    "supportedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "mode", "contracts"],
      "properties": {
        "flow": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "disabledRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "mode", "outcome"],
      "properties": {
        "flow": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["disabled", "unsupported"] }
      }
    }
  }
}
