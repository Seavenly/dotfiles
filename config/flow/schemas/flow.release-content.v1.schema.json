{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.release-content.v1.schema.json",
  "title": "flow.release-content/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "git_binding", "content_digest", "files"],
  "properties": {
    "schema": { "const": "flow.release-content/v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "git_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate_tree_sha",
        "qualification_base_commit",
        "included_paths",
        "excluded_paths"
      ],
      "properties": {
        "schema": { "const": "flow.release-content-git-binding/v1" },
        "candidate_tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "qualification_base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "included_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "git_blob_sha", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["100644", "100755"] },
          "git_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
