{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.transport-request.v1.schema.json",
  "title": "flow.transport-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "interface",
    "version",
    "request_id",
    "operation",
    "request"
  ],
  "properties": {
    "schema": { "const": "flow.transport-request/v1" },
    "interface": { "const": "flow.runtime/v1" },
    "version": { "const": 1 },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "enum": ["prepare", "launch", "command", "query", "watch"]
    },
    "request": {}
  }
}
