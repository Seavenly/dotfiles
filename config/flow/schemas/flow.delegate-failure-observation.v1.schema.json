{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.delegate-failure-observation.v1.schema.json",
  "title": "flow.delegate-failure-observation/v1",
  "description": "Redacted, typed operator observation for deterministic delegate materialization failures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "stage", "retryable"],
  "properties": {
    "schema": { "const": "flow.delegate-failure-observation/v1" },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_:-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "stage": {
      "type": "string",
      "const": "delegate_effect_materialization"
    },
    "retryable": { "type": "boolean" },
    "resource_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "watermark", "legal_next_actions"],
      "properties": {
        "schema": { "const": "flow.delegated-agent-resource-projection/v1" },
        "operation": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "resource_key": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding": { "type": ["object", "null"] },
        "delegation": { "type": ["object", "null"] },
        "watermark": {},
        "legal_next_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": ["object", "null"] },
        "cleanup_receipt": { "type": ["object", "null"] },
        "workspace": { "type": ["object", "null"] },
        "owner": { "type": "object" }
      }
    }
  }
}
