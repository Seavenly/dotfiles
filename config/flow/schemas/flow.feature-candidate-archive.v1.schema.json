{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.feature-candidate-archive.v1.schema.json",
  "title": "flow.feature-candidate-archive/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_schema", "bytes_digest", "digest", "size"],
  "properties": {
    "artifact_schema": { "const": "flow.feature-candidate-archive/v1" },
    "bytes_digest": { "$ref": "#/$defs/digest" },
    "digest": { "$ref": "#/$defs/digest" },
    "size": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
