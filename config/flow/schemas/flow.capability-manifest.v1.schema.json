{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.capability-manifest.v1.schema.json",
  "title": "flow.capability-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "release_id",
    "implementation",
    "scope",
    "not_authorized_before_issue",
    "normal_use_authorized",
    "remote_mutations_authorized",
    "supported_routes",
    "disabled_routes",
    "digest"
  ],
  "properties": {
    "schema": { "const": "flow.capability-manifest/v1" },
    "version": { "const": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "implementation": { "const": "flow-runtime/v1" },
    "scope": { "const": "dark_sacrificial" },
    "not_authorized_before_issue": { "const": 50 },
    "normal_use_authorized": { "const": false },
    "remote_mutations_authorized": { "const": false },
    "supported_routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "disabled_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/disabledRoute" }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "mode"],
      "properties": {
        "flow": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 }
      }
    },
    "disabledRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "mode", "outcome"],
      "properties": {
        "flow": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["disabled", "unsupported"] }
      }
    }
  }
}
