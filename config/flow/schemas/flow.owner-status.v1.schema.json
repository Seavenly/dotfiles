{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.owner-status.v1.schema.json",
  "title": "flow.owner-status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "state",
    "endpoint_path",
    "socket_path",
    "authority_directory",
    "pid",
    "process_identity",
    "process_start_identity",
    "started_at"
  ],
  "properties": {
    "schema": { "const": "flow.owner-status/v1" },
    "version": { "const": 1 },
    "state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "stale",
        "invalid",
        "owner_mismatch",
        "unknown"
      ]
    },
    "endpoint_path": { "type": "string", "minLength": 1 },
    "socket_path": { "type": "string", "minLength": 1 },
    "authority_directory": { "type": "string", "minLength": 1 },
    "pid": { "type": ["integer", "null"], "minimum": 1 },
    "process_identity": { "type": ["string", "null"], "minLength": 1 },
    "process_start_identity": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "started_at": { "type": ["string", "null"], "minLength": 1 },
    "owner_token": { "type": "string", "minLength": 8 },
    "reason": { "type": "string", "minLength": 1 },
    "previous_state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "stale",
        "invalid",
        "owner_mismatch",
        "unknown"
      ]
    },
    "forced": { "type": "boolean" },
    "startup_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "runner": {
      "$ref": "flow.runtime-runner-status.v1.schema.json"
    },
    "runner_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "operator_errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "suppressed", "last"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "last": {
          "oneOf": [
            { "$ref": "#/$defs/operator-error" },
            { "type": "null" }
          ]
        }
      }
    },
    "runtime_binding": { "$ref": "#/$defs/runtime-binding" }
  },
  "$defs": {
    "runtime-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "runtime_module_path",
        "runtime_module_sha256",
        "config_directory",
        "config_directory_sha256",
        "qualification_repository_root",
        "release_content_digest",
        "release_content_bytes_sha256"
      ],
      "properties": {
        "schema": { "const": "flow.owner-runtime-binding/v1" },
        "runtime_module_path": { "type": "string", "pattern": "^/" },
        "runtime_module_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "config_directory": { "type": "string", "pattern": "^/" },
        "config_directory_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "qualification_repository_root": { "type": "string", "pattern": "^/" },
        "release_content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "release_content_bytes_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "operator-error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name", "message", "code"],
      "properties": {
        "source": { "enum": ["lifecycle", "runner", "transport"] },
        "name": { "const": "Error" },
        "message": {
          "enum": ["Autonomous runner error", "Flow transport error"]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    }
  }
}
