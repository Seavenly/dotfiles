{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.owner-status.v1.schema.json",
  "title": "flow.owner-status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "state",
    "endpoint_path",
    "socket_path",
    "authority_directory",
    "pid",
    "process_identity",
    "process_start_identity",
    "started_at"
  ],
  "properties": {
    "schema": { "const": "flow.owner-status/v1" },
    "version": { "const": 1 },
    "state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "stale",
        "invalid",
        "owner_mismatch",
        "unknown"
      ]
    },
    "endpoint_path": { "type": "string", "minLength": 1 },
    "socket_path": { "type": "string", "minLength": 1 },
    "authority_directory": { "type": "string", "minLength": 1 },
    "pid": { "type": ["integer", "null"], "minimum": 1 },
    "process_identity": { "type": ["string", "null"], "minLength": 1 },
    "process_start_identity": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "started_at": { "type": ["string", "null"], "minLength": 1 },
    "owner_token": { "type": "string", "minLength": 8 },
    "reason": { "type": "string", "minLength": 1 },
    "previous_state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "stale",
        "invalid",
        "owner_mismatch",
        "unknown"
      ]
    },
    "forced": { "type": "boolean" },
    "startup_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    }
  }
}
