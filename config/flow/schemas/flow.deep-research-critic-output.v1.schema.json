{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.deep-research-critic-output/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question_id",
    "cycle",
    "answer",
    "assurance",
    "citations",
    "findings",
    "residual_gaps",
    "revise_angles",
    "proposed_question",
    "retained_evidence_digest"
  ],
  "properties": {
    "schema": {
      "const": "flow.deep-research-critic-output/v1"
    },
    "question_id": {
      "type": "string"
    },
    "cycle": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "assurance": {
      "const": "lower"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "digest"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "residual_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "revise_angles": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "angle:1",
          "angle:2"
        ]
      }
    },
    "proposed_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "retained_evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
