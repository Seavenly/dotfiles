{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.research-source-packet.v1.schema.json",
  "title": "flow.research-source-packet/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question",
    "sources",
    "packet_digest"
  ],
  "properties": {
    "schema": {
      "const": "flow.research-source-packet/v1"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^question:[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uri",
          "digest",
          "size_bytes",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^source:[0-9a-f]{64}$"
          },
          "uri": {
            "type": "string",
            "pattern": "^urn:sha256:[0-9a-f]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      }
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
