{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.direct-feature-apply-output.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation",
    "feature_evidence"
  ],
  "properties": {
    "schema": {
      "const": "flow.delegate-evidence/v1"
    },
    "observation": {
      "type": "string",
      "maxLength": 2048
    },
    "feature_evidence": {
      "title": "flow.feature-criterion-evidence/v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "criteria"
      ],
      "properties": {
        "schema": {
          "const": "flow.feature-criterion-evidence/v1"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "expected",
              "kind",
              "target"
            ],
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "git_file_sha256"
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "expected": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                }
              }
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "maxLength": 1048576
              },
              "kind": {
                "enum": [
                  "git_file_equals",
                  "git_file_sha256"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^/\\\\-][^\\\\]*$"
              }
            }
          }
        }
      }
    }
  }
}
