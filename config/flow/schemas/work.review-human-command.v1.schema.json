{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/work.review-human-command.v1.schema.json",
  "title": "work.review-human-command/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "contract",
    "command_id",
    "subject_id",
    "review_id",
    "target_fingerprint",
    "candidate_fingerprint",
    "candidate_authority_watermark",
    "lifecycle_generation",
    "expected_watermark",
    "expected_generation"
  ],
  "properties": {
    "schema": { "const": "work.review-human-command/v1" },
    "type": {
      "enum": [
        "review_session_start",
        "review_comment",
        "review_disposition",
        "review_approval",
        "review_supersession",
        "review_integration"
      ]
    },
    "contract": { "const": "work.review/v1" },
    "command_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "review_id": { "type": "string", "minLength": 1 },
    "target_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_authority_watermark": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lifecycle_generation": { "type": "integer", "minimum": 1 },
    "expected_watermark": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected_generation": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string", "minLength": 1 },
    "comment_id": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "finding_id": { "type": "string", "minLength": 1 },
    "disposition": {
      "enum": ["accept", "request_changes", "dismiss", "defer"]
    },
    "decision": { "enum": ["approve", "revoke"] },
    "operator_input": { "$ref": "#/$defs/operatorInput" },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_fingerprint", "lifecycle_generation"],
      "properties": {
        "candidate_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lifecycle_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "$ref": "https://dotfiles.local/schemas/flow.review-integration-evidence.v1.schema.json"
    }
  },
  "oneOf": [
    {
      "required": ["type", "session_id"],
      "properties": {
        "type": { "const": "review_session_start" },
        "session_id": {}
      },
      "not": {
        "type": "object",
        "properties": { "operator_input": {} },
        "required": ["operator_input"]
      }
    },
    {
      "required": ["type", "operator_input"],
      "properties": {
        "type": { "const": "review_session_start" },
        "session_id": {},
        "operator_input": {
          "allOf": [
            { "$ref": "#/$defs/operatorInput" },
            {
              "type": "object",
              "properties": {
                "action": { "const": "review_session_start" },
                "required": { "const": ["session_id"] }
              },
              "not": {
                "properties": { "optional": {} },
                "required": ["optional"]
              }
            }
          ]
        }
      },
      "not": {
        "type": "object",
        "properties": { "session_id": {} },
        "required": ["session_id"]
      }
    },
    {
      "required": ["type", "session_id", "comment_id", "body"],
      "properties": {
        "type": { "const": "review_comment" },
        "session_id": {},
        "comment_id": {},
        "body": {}
      },
      "not": {
        "type": "object",
        "properties": { "operator_input": {} },
        "required": ["operator_input"]
      }
    },
    {
      "required": ["type", "session_id", "operator_input"],
      "properties": {
        "type": { "const": "review_comment" },
        "session_id": {},
        "operator_input": {
          "allOf": [
            { "$ref": "#/$defs/operatorInput" },
            {
              "type": "object",
              "properties": {
                "action": { "const": "review_comment" },
                "required": { "const": ["comment_id", "body"] }
              },
              "not": {
                "properties": { "optional": {} },
                "required": ["optional"]
              }
            }
          ]
        }
      },
      "not": { "anyOf": [
        {
          "type": "object",
          "properties": { "comment_id": {} },
          "required": ["comment_id"]
        },
        {
          "type": "object",
          "properties": { "body": {} },
          "required": ["body"]
        }
      ] }
    },
    {
      "required": ["type", "session_id", "disposition"],
      "properties": {
        "type": { "const": "review_disposition" },
        "session_id": {},
        "disposition": {}
      },
      "not": {
        "type": "object",
        "properties": { "operator_input": {} },
        "required": ["operator_input"]
      }
    },
    {
      "required": ["type", "session_id", "operator_input"],
      "properties": {
        "type": { "const": "review_disposition" },
        "session_id": {},
        "operator_input": {
          "allOf": [
            { "$ref": "#/$defs/operatorInput" },
            {
              "required": [
                "schema",
                "action",
                "required",
                "optional",
                "allowed_dispositions"
              ],
              "type": "object",
              "properties": {
                "action": { "const": "review_disposition" },
                "required": { "const": ["disposition"] },
                "optional": { "const": ["finding_id"] },
                "allowed_dispositions": {
                  "const": ["accept", "request_changes", "dismiss", "defer"]
                }
              }
            }
          ]
        }
      },
      "not": {
        "type": "object",
        "properties": { "disposition": {} },
        "required": ["disposition"]
      }
    },
    {
      "required": ["type", "session_id", "decision"],
      "properties": {
        "type": { "const": "review_approval" },
        "session_id": {},
        "decision": {}
      },
      "not": {
        "type": "object",
        "properties": { "operator_input": {} },
        "required": ["operator_input"]
      }
    },
    {
      "required": ["type", "session_id", "replacement"],
      "properties": {
        "type": { "const": "review_supersession" },
        "session_id": {},
        "replacement": {}
      },
      "not": {
        "type": "object",
        "properties": { "operator_input": {} },
        "required": ["operator_input"]
      }
    },
    {
      "required": ["type", "session_id", "operator_input"],
      "properties": {
        "type": { "const": "review_supersession" },
        "session_id": {},
        "operator_input": {
          "allOf": [
            { "$ref": "#/$defs/operatorInput" },
            {
              "type": "object",
              "properties": {
                "action": { "const": "review_supersession" },
                "required": { "const": ["replacement"] },
                "replacement": {
                  "type": "object",
                  "required": ["required"],
                  "properties": {
                    "required": {
                      "const": ["candidate_fingerprint", "lifecycle_generation"]
                    }
                  }
                }
              },
              "required": ["schema", "action", "required", "replacement"],
              "not": {
                "properties": { "optional": {} },
                "required": ["optional"]
              }
            }
          ]
        }
      },
      "not": {
        "type": "object",
        "properties": { "replacement": {} },
        "required": ["replacement"]
      }
    },
    {
      "required": ["type", "session_id", "evidence"],
      "properties": {
        "type": { "const": "review_integration" },
        "session_id": {},
        "evidence": {}
      },
      "not": {
        "type": "object",
        "properties": { "operator_input": {} },
        "required": ["operator_input"]
      }
    },
    {
      "required": ["type", "session_id", "operator_input"],
      "properties": {
        "type": { "const": "review_integration" },
        "session_id": {},
        "operator_input": {
          "allOf": [
            { "$ref": "#/$defs/operatorInput" },
            {
              "required": ["schema", "action", "required", "evidence_schema"],
              "type": "object",
              "properties": {
                "action": { "const": "review_integration" },
                "required": { "const": ["evidence"] },
                "evidence_schema": {
                  "const": "flow.review-integration-evidence/v1"
                }
              },
              "not": {
                "properties": { "optional": {} },
                "required": ["optional"]
              }
            }
          ]
        }
      },
      "not": { "anyOf": [
        {
          "type": "object",
          "properties": { "evidence": {} },
          "required": ["evidence"]
        },
        {
          "type": "object",
          "properties": { "integration_evidence": {} },
          "required": ["integration_evidence"]
        }
      ] }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "review_session_start" } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "comment_id": {} }, "required": ["comment_id"] },
            { "properties": { "body": {} }, "required": ["body"] },
            { "properties": { "finding_id": {} }, "required": ["finding_id"] },
            { "properties": { "disposition": {} }, "required": ["disposition"] },
            { "properties": { "decision": {} }, "required": ["decision"] },
            { "properties": { "replacement": {} }, "required": ["replacement"] },
            { "properties": { "evidence": {} }, "required": ["evidence"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "review_comment" } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "finding_id": {} }, "required": ["finding_id"] },
            { "properties": { "disposition": {} }, "required": ["disposition"] },
            { "properties": { "decision": {} }, "required": ["decision"] },
            { "properties": { "replacement": {} }, "required": ["replacement"] },
            { "properties": { "evidence": {} }, "required": ["evidence"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "review_disposition" } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "comment_id": {} }, "required": ["comment_id"] },
            { "properties": { "body": {} }, "required": ["body"] },
            { "properties": { "decision": {} }, "required": ["decision"] },
            { "properties": { "replacement": {} }, "required": ["replacement"] },
            { "properties": { "evidence": {} }, "required": ["evidence"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "review_approval" } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "comment_id": {} }, "required": ["comment_id"] },
            { "properties": { "body": {} }, "required": ["body"] },
            { "properties": { "finding_id": {} }, "required": ["finding_id"] },
            { "properties": { "disposition": {} }, "required": ["disposition"] },
            { "properties": { "replacement": {} }, "required": ["replacement"] },
            { "properties": { "evidence": {} }, "required": ["evidence"] },
            { "properties": { "operator_input": {} }, "required": ["operator_input"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "review_supersession" } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "comment_id": {} }, "required": ["comment_id"] },
            { "properties": { "body": {} }, "required": ["body"] },
            { "properties": { "finding_id": {} }, "required": ["finding_id"] },
            { "properties": { "disposition": {} }, "required": ["disposition"] },
            { "properties": { "decision": {} }, "required": ["decision"] },
            { "properties": { "evidence": {} }, "required": ["evidence"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "review_integration" } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "comment_id": {} }, "required": ["comment_id"] },
            { "properties": { "body": {} }, "required": ["body"] },
            { "properties": { "finding_id": {} }, "required": ["finding_id"] },
            { "properties": { "disposition": {} }, "required": ["disposition"] },
            { "properties": { "decision": {} }, "required": ["decision"] },
            { "properties": { "replacement": {} }, "required": ["replacement"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "review_disposition" },
          "operator_input": { "type": "object" }
        },
        "required": ["type", "operator_input"]
      },
      "then": {
        "not": {
          "properties": { "finding_id": {} },
          "required": ["finding_id"]
        }
      }
    }
  ],
  "$defs": {
    "operatorInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "required"],
      "properties": {
        "schema": { "const": "flow.review-operator-input/v1" },
        "action": {
          "enum": [
            "review_session_start",
            "review_comment",
            "review_disposition",
            "review_supersession",
            "review_integration"
          ]
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "session_id",
              "comment_id",
              "body",
              "disposition",
              "finding_id",
              "replacement",
              "evidence"
            ]
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "session_id",
              "comment_id",
              "body",
              "disposition",
              "finding_id",
              "replacement",
              "evidence"
            ]
          }
        },
        "allowed_dispositions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["accept", "request_changes", "dismiss", "defer"]
          }
        },
        "evidence_schema": {
          "const": "flow.review-integration-evidence/v1"
        },
        "replacement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["candidate_fingerprint", "lifecycle_generation"] }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "action": { "const": "review_session_start" }
          },
          "not": {
            "anyOf": [
              { "properties": { "optional": {} }, "required": ["optional"] },
              { "properties": { "allowed_dispositions": {} }, "required": ["allowed_dispositions"] },
              { "properties": { "evidence_schema": {} }, "required": ["evidence_schema"] },
              { "properties": { "replacement": {} }, "required": ["replacement"] }
            ]
          }
        },
        {
          "properties": {
            "action": { "const": "review_comment" }
          },
          "not": {
            "anyOf": [
              { "properties": { "optional": {} }, "required": ["optional"] },
              { "properties": { "allowed_dispositions": {} }, "required": ["allowed_dispositions"] },
              { "properties": { "evidence_schema": {} }, "required": ["evidence_schema"] },
              { "properties": { "replacement": {} }, "required": ["replacement"] }
            ]
          }
        },
        {
          "properties": {
            "action": { "const": "review_disposition" }
          },
          "not": {
            "anyOf": [
              { "properties": { "evidence_schema": {} }, "required": ["evidence_schema"] },
              { "properties": { "replacement": {} }, "required": ["replacement"] }
            ]
          }
        },
        {
          "properties": {
            "action": { "const": "review_supersession" }
          },
          "not": {
            "anyOf": [
              { "properties": { "optional": {} }, "required": ["optional"] },
              { "properties": { "allowed_dispositions": {} }, "required": ["allowed_dispositions"] },
              { "properties": { "evidence_schema": {} }, "required": ["evidence_schema"] }
            ]
          }
        },
        {
          "properties": {
            "action": { "const": "review_integration" }
          },
          "not": {
            "anyOf": [
              { "properties": { "optional": {} }, "required": ["optional"] },
              { "properties": { "allowed_dispositions": {} }, "required": ["allowed_dispositions"] },
              { "properties": { "replacement": {} }, "required": ["replacement"] }
            ]
          }
        }
      ]
    }
  }
}
