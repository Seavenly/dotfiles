{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.dark-opt-in.v1.schema.json",
  "title": "flow.dark-opt-in/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "purpose"],
  "properties": {
    "schema": { "const": "flow.dark-opt-in/v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "purpose": { "const": "sacrificial_qualification" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow", "mode"],
        "properties": {
          "flow": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
