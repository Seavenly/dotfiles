{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.required-authority-revalidation.v1.schema.json",
  "title": "flow.required-authority-revalidation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "valid", "expected", "observed", "issues"],
  "properties": {
    "schema": { "const": "flow.required-authority-revalidation/v1" },
    "valid": { "type": "boolean" },
    "expected": {
      "type": "array",
      "items": { "$ref": "flow.required-authority-binding.v1.schema.json" }
    },
    "observed": {
      "type": "array",
      "items": { "$ref": "flow.required-authority-binding.v1.schema.json" }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
  },
  "$defs": {
    "provider_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "version"],
      "properties": {
        "schema": { "const": "flow.registered-authority/v1" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "authority_id",
        "authority_contract",
        "authority_provider_identity",
        "authority_watermark",
        "authority_generation",
        "legal_actions"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": ["string", "null"] },
        "authority_id": { "type": ["string", "null"] },
        "authority_contract": { "type": ["string", "null"] },
        "authority_provider_identity": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/provider_identity" }
          ]
        },
        "authority_watermark": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority_generation": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "legal_actions": { "type": "array" }
      }
    }
  }
}
