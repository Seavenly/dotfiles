{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/flow.review-inbox-watermark.v1.schema.json",
  "title": "flow.review-inbox-watermark/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projection_digest", "subject_watermarks"],
  "properties": {
    "schema": { "const": "flow.review-inbox-watermark/v1" },
    "projection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_watermarks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/subjectWatermark" }
    }
  },
  "$defs": {
    "subjectWatermark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_kind", "stream_id", "subject_id", "watermark"],
      "properties": {
        "stream_kind": { "enum": ["candidate", "review"] },
        "stream_id": {
          "type": "string",
          "pattern": "^work:work\\.review/v1:.+$"
        },
        "subject_id": { "type": "string", "minLength": 1 },
        "watermark": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
