    "flow.rejection/v1",
    "flow.effect-intent/v1",
    "flow.effect-observation/v1",
    "flow.effect-receipt/v1",
    "flow.run-plan/v1",
    "flow.run-projection/v1",
    "flow.run-index-projection/v1",
    "flow.card-block/v1",
    "flow.card-block-observation/v1",
    "flow.adapter/card-block-observation/v1",
    "flow.validator/card-block-observation/v1",
    "flow.revision-trigger/v1",
    "flow.plan-revision-template/v1",
    "flow.authority-schema-transition/v1",
    "flow.authority-schema-transition-boundary/v1",
    "flow.authority-schema-compatibility/v1",
    "flow.runtime-release/v1",
    "flow.checkpoint/confirmation/v1",
    "flow.validator/checkpoint-decision/v1",
    "flow.resource-handoff/v1",
    "flow.launch-policy/v1",
    "flow.transition-ledger/v1",
    "flow.transition-projection/v1",
    "flow.legacy-baseline-inventory/v1",
    "flow.legacy-compatibility-inventory/v1",
    "flow.delegated-agent-port/v1",
    "flow.drovr-required-features/v1",
    "flow.delegated-agent-description-request/v1",
    "flow.delegated-agent-description-projection/v1",
    "drovr.delegated-agent-description-request/v1",
    "drovr.delegated-agent-description/v1",
    "drovr.launch-description/v1",
    "drovr.effective-authority/v1",
    "drovr.capacity/v1",
    "drovr.credential-reference/v1",
    "drovr.feature-advertisement/v1",
    "drovr.feature/exact-launch-description/v1",
    "drovr.feature/caller-idempotent-dispatch/v1",
    "drovr.feature/caller-idempotent-discovery/v1",
    "drovr.feature/caller-keyed-ordered-input/v1",
    "drovr.feature/bounded-observation/v1",
    "drovr.feature/bounded-wait/v1",
    "drovr.feature/transcript-correlation/v1",
    "drovr.feature/cancellation/v1",
    "drovr.feature/reconciliation/v1",
    "drovr.feature/terminal-proof-classification/v1",
    "drovr.feature/late-result-correlation/v1",
    "drovr.feature/launch-binding-settlement-proof/v1",
    "drovr.feature/opaque-caller-ownership-metadata/v1",
    "drovr.feature/feature-advertisement/v1",
    "work.workspace/v1",
    "work.artifact/v1",
    "work.review/v1",
    "work.stack/v1"
  ],
  "run_plan": {
    "contract": "flow.run-plan/v1",
    "executor_kinds": [
      "delegate",
      "operation",
      "checkpoint",
      "subrun"
    ]
  },
  "authorities": {
    "flow_lifecycle": "RunAuthority",
    "workspace": "WorkspaceAuthority",
    "artifact": "ArtifactAuthority",
    "review": "ReviewAuthority",
    "stack": "StackAuthority"
  },
  "registered_work_domains": [
    {
      "contract": "work.workspace/v1",
      "authority": "WorkspaceAuthority"
    },
    {
      "contract": "work.artifact/v1",
      "authority": "ArtifactAuthority"
    },
    {
      "contract": "work.review/v1",
      "authority": "ReviewAuthority"
    },
    {
      "contract": "work.stack/v1",
      "authority": "StackAuthority"
    }
  ],
  "modules": {
    "plan_compiler": {
      "purity": "pure",
      "ambient_reads": false
    },
    "lifecycle_kernel": {
      "purity": "pure",
      "ambient_reads": false
    },
    "effect_coordinator": {
      "authority": "mechanism_only",
      "effect_classes": [
        "read_only",
        "caller_idempotent",
        "reconcilable",
        "one_shot_uncertain"
      ]
    }
  },
  "mechanism_adapters": [
    "git",
    "forge",
    "tracker",
    "filesystem",
    "artifact_bytes",
    "card_block_observation",
    "delegated_runtime",
    "convergence_launch_policy"
  ],
  "projections": [
    "kanban",
    "graph",
    "timeline",
    "trust",
    "operator",
    "tracker_progress",
    "review_inbox",
    "transition",
    "delegated_agent_description",
    "legacy_compatibility_inventory",
    "authority_schema_compatibility"
  ],
  "authority_roots": {
    "legacy_claude": {
      "base": "home",
      "path": ".agent-teams"
    },
    "legacy_agent_flow": {
      "base": "state",
      "path": "agent-flow"
    },
    "replacement": {
      "base": "state",
      "path": "flow"
    }
  },
  "legacy_import": {
    "adapters": [],
    "required_validations": [
      "digest",
      "schema",
      "provenance",
      "redaction",
      "classification",
      "retention",
      "allowed_use"
    ],
    "allowed_subjects": [
      "artifact_bytes"
    ],
    "forbidden_authority": [
      "lifecycle_state",
      "grants",
      "checkpoints",
      "approval",
      "review_currency",
      "integration_eligibility",
      "effect_causation",
      "completion"
    ]
  }
}
