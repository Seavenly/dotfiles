{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/agent-flow.validation.v1.schema.json",
  "title": "agent-flow.validation/v1",
  "description": "Durable output evidence produced by authoritative completed-attempt validation; never an authorization input by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "stage",
    "task_id",
    "attempt",
    "validated_at",
    "source_metadata_sha256",
    "provenance",
    "valid",
    "identity",
    "semantic",
    "approved_artifact_roots",
    "validated_artifact_root",
    "artifacts",
    "errors"
  ],
  "properties": {
    "schema": { "const": "agent-flow.validation/v1" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "stage": { "$ref": "#/$defs/stageKey" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "validated_at": { "$ref": "#/$defs/timestamp" },
    "source_metadata_sha256": { "$ref": "#/$defs/sha256" },
    "provenance": {
      "description": "Hermes attempt and sealed run manifest used by the authority validator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_manifest_path", "run_manifest_sha256", "hermes_attempt_id"],
      "properties": {
        "run_manifest_path": { "$ref": "#/$defs/absolutePath" },
        "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "hermes_attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "valid": { "type": "boolean" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_schema", "run_id", "stage", "attempt"],
      "properties": {
        "handoff_schema": { "const": "agent-flow.handoff/v1" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "stage": { "$ref": "#/$defs/stageKey" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed"],
      "properties": {
        "required": { "type": "boolean" },
        "passed": { "type": ["boolean", "null"] }
      }
    },
    "approved_artifact_roots": {
      "description": "Evidence copy of roots derived from the sealed run manifest, not caller-selected authority.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/absolutePath" }
    },
    "validated_artifact_root": { "$ref": "#/$defs/absolutePath" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "path", "expected_sha256", "actual_sha256", "valid"],
        "properties": {
          "source_path": { "$ref": "#/$defs/absolutePath" },
          "path": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/absolutePath" }
            ]
          },
          "expected_sha256": { "$ref": "#/$defs/sha256" },
          "actual_sha256": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/sha256" }
            ]
          },
          "valid": { "type": "boolean" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } }, "required": ["valid"] },
      "then": {
        "properties": { "errors": { "type": "array", "maxItems": 0 } }
      },
      "else": {
        "properties": { "errors": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2 },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stageKey": { "type": "string", "pattern": "^[a-z][a-z0-9:-]{0,127}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
