{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/agent-flow.spike-result.v1.schema.json",
  "title": "agent-flow.spike-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_sha", "report_path", "prototype", "retained_evidence", "residual_gaps", "stuck_slices"],
  "properties": {
    "schema": { "const": "agent-flow.spike-result/v1" },
    "run_id": { "$ref": "#/$defs/id" },
    "source_sha": { "$ref": "#/$defs/sha" },
    "report_path": { "$ref": "#/$defs/path" },
    "prototype": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["experiment_path", "head_sha", "worktree"],
          "properties": {
            "experiment_path": { "$ref": "#/$defs/path" },
            "head_sha": { "$ref": "#/$defs/sha" },
            "worktree": { "$ref": "#/$defs/path" }
          }
        }
      ]
    },
    "retained_evidence": { "type": "array", "items": {} },
    "residual_gaps": { "type": "array", "items": {} },
    "stuck_slices": { "type": "array", "items": {} }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "path": { "type": "string", "pattern": "^/", "minLength": 2 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
  }
}
