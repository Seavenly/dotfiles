{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/agent-flow.migration-receipt.v1.schema.json",
  "title": "agent-flow.migration-receipt/v1",
  "description": "Append-only approval for resuming an immutable run under a compatible identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "run_id", "from", "to", "changes", "approval"],
  "properties": {
    "schema": { "const": "agent-flow.migration-receipt/v1" },
    "receipt_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "from": { "$ref": "#/$defs/compatibilityIdentity" },
    "to": { "$ref": "#/$defs/compatibilityIdentity" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "prior_sha256", "next_sha256"],
        "properties": {
          "kind": {
            "enum": ["implementation", "graph", "gate", "input", "profile", "skill", "contract"]
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "prior_sha256": { "$ref": "#/$defs/sha256" },
          "next_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "approved_at", "reason", "evidence_path"],
      "properties": {
        "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence_path": { "$ref": "#/$defs/absolutePath" }
      }
    }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2 },
    "gitRevision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "compatibilityIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "implementation_revision", "profile_set_fingerprint"],
      "properties": {
        "contract_version": { "type": "integer", "minimum": 1 },
        "implementation_revision": { "$ref": "#/$defs/gitRevision" },
        "profile_set_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
