#!/usr/bin/env bash
set -euo pipefail

# tmux hotkey (prefix + r): a review inbox that surfaces, in one fzf list:
#   - local agent reviews from the `tuicr-reviews` registry  (kind: agent -> tuicr)
#   - coworker PRs from a cron feed, in an `── external ──` section (-> browser):
#       kind=reply   a coworker commented on YOUR PR (shown first)
#       kind=review  a coworker's PR needs YOUR review
# Local (agent) reviews are listed first, then the external section.
#
# Coworker PRs come from a JSONL sidecar the PR-notifier cron writes, one PR per
# line. Recognised fields:
#   {"repo","number","title","url",
#    "kind":"review"|"reply",                  # default "review"
#    "state":"approved"|"changes_requested"|"commented"}   # optional, for reply
# Override the path with COWORKER_PRS_FILE (default
# ~/.local/state/dotfiles/coworker-review-prs.jsonl). Missing file -> local only.
#
# Status column glyphs: ● an open tuicr window (agent); ✓ approved (agent
# review, or a PR of yours); ✗ changes requested; • comments only.
# In the picker: Enter opens the item; ctrl-a toggles approval on a local review
# (no-op elsewhere).
#
# Runs inside a `tmux display-popup`. `--lines` prints composed rows (fzf's
# reload after a toggle); `--approve <type> <wt> <base> <branch>` toggles a
# local review's approval (used by the ctrl-a bind).

reviews_bin="tuicr-reviews"
command -v "$reviews_bin" >/dev/null 2>&1 || reviews_bin="$HOME/.local/bin/tuicr-reviews"
self="$(command -v tmux-review-inbox 2>/dev/null || printf '%s' "$0")"
coworker_file="${COWORKER_PRS_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/coworker-review-prs.jsonl}"

if [[ "${1:-}" == "--approve" ]]; then
  shift
  if [[ "${1:-}" == "local" && -n "${2:-}" && -n "${3:-}" && -n "${4:-}" ]]; then
    "$reviews_bin" toggle-approved --worktree "$2" --base "$3" --branch "$4"
  fi
  exit 0
fi

# Compose picker rows: display <tab> action <tab> a <tab> b <tab> c
#   local (agent):  action=local  a=worktree b=base c=branch
#   external PR:    action=pr     a=url
#   separator:      action=sep
# Display columns: status(2) kind repo ref (+ summary/title), aligned widths.
build_lines() {
  local local_rows pr_rows
  local_rows="$("$reviews_bin" list 2>/dev/null || true)"
  pr_rows=""
  [[ -s "$coworker_file" ]] && pr_rows="$(jq -r '[.repo,(.number|tostring),.title,.url,(.kind // "review"),(.state // "")] | @tsv' "$coworker_file" 2>/dev/null || true)"
  {
    tmux list-windows -F '#{@tuicr_wt}'$'\t''#{@tuicr_rev}' 2>/dev/null \
      | awk -F'\t' '$1 != "" { print "O\t" $1 "\t" $2 }'
    [[ -n "$local_rows" ]] && printf '%s\n' "$local_rows" | awk -F'\t' '{ print "L\t" $0 }'
    [[ -n "$pr_rows" ]]    && printf '%s\n' "$pr_rows"    | awk -F'\t' '{ print "P\t" $0 }'
  } | awk -F'\t' -v gap="    " '
      function pad(s,w) { return sprintf("%-*s", w, s) }
      function glyph(s) {
        return (s=="approved") ? "✓" : \
               (s=="changes_requested" || s=="changes") ? "✗" : \
               (s=="commented" || s=="comments") ? "•" : " "
      }
      function emitrow(st2,kind,repo,ref,text,action,a,b,c,   disp) {
        disp = st2 " " pad(kind,wkind) gap pad(repo,wrepo) gap pad(ref,wref)
        if (text != "") disp = disp gap text
        printf "%s\t%s\t%s\t%s\t%s\n", disp, action, a, b, c
      }
      $1 == "O" { isopen[$2 SUBSEP $3] = 1; next }
      $1 == "L" {
        nl++; Lwt[nl]=$2; Lbase[nl]=$3; Lbranch[nl]=$4; Lsum[nl]=$8; Lappr[nl]=($9=="true")
        m=split($5,p,"/"); Lrepo[nl]=p[m]; Lref[nl]=$3 ".." $4
        Lopen[nl]=(isopen[$2 SUBSEP ($3 ".." $4)] ? 1 : 0)
        if (length(Lrepo[nl])>wrepo) wrepo=length(Lrepo[nl])
        if (length(Lref[nl])>wref)   wref=length(Lref[nl])
        if (5>wkind) wkind=5
        next
      }
      $1 == "P" {
        np++; Pnum[np]=$3; Ptitle[np]=$4; Purl[np]=$5
        Pkind[np]=($6==""?"review":$6); Pstate[np]=$7
        m=split($2,p,"/"); Prepo[np]=p[m]; Pref[np]="#" $3
        if (length(Prepo[np])>wrepo) wrepo=length(Prepo[np])
        if (length(Pref[np])>wref)   wref=length(Pref[np])
        if (length(Pkind[np])>wkind) wkind=length(Pkind[np])
        next
      }
      END {
        for (pass=1; pass<=2; pass++)
          for (i=1;i<=nl;i++) {
            if ((pass==1) != (Lopen[i]==1)) continue
            st2=(Lopen[i]?"●":" ") (Lappr[i]?"✓":" ")
            emitrow(st2,"agent",Lrepo[i],Lref[i],Lsum[i],"local",Lwt[i],Lbase[i],Lbranch[i])
          }
        if (np>0) {
          printf "%s\t%s\t\t\t\n", "── external ──", "sep"
          n=split("reply review", order, " ")
          for (o=1;o<=n;o++)
            for (i=1;i<=np;i++) {
              if (Pkind[i] != order[o]) continue
              emitrow(" " glyph(Pstate[i]), Pkind[i], Prepo[i], Pref[i], Ptitle[i], "pr", Purl[i], "", "")
            }
          for (i=1;i<=np;i++) {
            if (Pkind[i]=="reply" || Pkind[i]=="review") continue
            emitrow(" " glyph(Pstate[i]), Pkind[i], Prepo[i], Pref[i], Ptitle[i], "pr", Purl[i], "", "")
          }
        }
      }
    '
}

if [[ "${1:-}" == "--lines" ]]; then build_lines; exit 0; fi

lines="$(build_lines)"
if [[ -z "$lines" ]]; then
  echo "Review inbox is empty (no local reviews, and no coworker PR feed)." >&2
  sleep 2; exit 0
fi

hdr="enter: open   ctrl-a: approve   |   ● open  ✓ approved  ✗ changes  • comments"
[[ -s "$coworker_file" ]] && hdr="$hdr   |   feed: $(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$coworker_file" 2>/dev/null || echo '?')"

selection="$(
  printf '%s\n' "$lines" | fzf --no-preview --reverse --delimiter=$'\t' --with-nth=1 --nth=1 \
    --prompt="review inbox > " --header="$hdr" \
    --bind "ctrl-a:execute-silent($self --approve {2} {3} {4} {5})+reload($self --lines)"
)" || exit 0
[[ -z "$selection" ]] && exit 0

action="$(printf '%s' "$selection" | cut -f2)"
case "$action" in
  sep) exit 0 ;;
  pr)
    url="$(printf '%s' "$selection" | cut -f3)"
    [[ -n "$url" ]] && { open "$url" 2>/dev/null || xdg-open "$url" 2>/dev/null || true; }
    ;;
  local)
    worktree="$(printf '%s' "$selection" | cut -f3)"
    base="$(printf '%s' "$selection" | cut -f4)"
    branch="$(printf '%s' "$selection" | cut -f5)"
    if [[ -z "$worktree" || ! -d "$worktree" ]]; then
      echo "tmux-review-inbox: worktree is missing: $worktree" >&2; sleep 2; exit 0
    fi
    revset="${base}..${branch}"
    existing="$(tmux list-windows -F '#{window_index}'$'\t''#{@tuicr_wt}'$'\t''#{@tuicr_rev}' \
      | awk -F'\t' -v w="$worktree" -v r="$revset" '$2 == w && $3 == r { print $1; exit }')"
    if [[ -n "$existing" ]]; then
      tmux select-window -t ":$existing"
    else
      idx="$(tmux new-window -P -F '#{window_index}' -c "$worktree" -n "tuicr:${branch}" \
        "zsh -i -c 'tuicr -r \"${revset}\"'")"
      tmux set-option -w -t ":$idx" @tuicr_wt "$worktree"
      tmux set-option -w -t ":$idx" @tuicr_rev "$revset"
    fi
    ;;
esac
