#!/usr/bin/env bash
set -euo pipefail

root="${DOTFILES_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
root="$(cd "$root" && pwd -P)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
migrations="$state_dir/migrations"

mkdir -p "$config_dir" "$cache_dir/antidote" "$cache_dir/zsh" "$migrations" "$HOME/.local/bin"
mkdir -p "$HOME/Pictures/Screenshots"

legacy_links=(
  "$HOME/.config/zshrc|$root/zshrc"
  "$HOME/.config/kitty|$root/kitty"
  "$HOME/.aider.conf.yml|$root/aider/.aider.conf.yml"
  "$HOME/.local/bin/sesh-list|$root/bin/sesh-list"
  "$HOME/.local/bin/sesh-pick|$root/bin/sesh-pick"
)
for pair in "${legacy_links[@]}"; do
  link="${pair%%|*}"
  expected="${pair#*|}"
  if [[ -L "$link" && "$(readlink "$link")" == "$expected" ]]; then
    unlink "$link"
  fi
done
touch "$migrations/006-legacy-broken-links"

if [[ ! -e "$migrations/001-local-aliases" ]]; then
  if [[ ! -e "$config_dir/aliases.local.zsh" ]]; then
    install -m 0600 "$root/docs/migrations/v1-aliases.zsh" "$config_dir/aliases.local.zsh"
  fi
  touch "$migrations/001-local-aliases"
fi

private_file="$config_dir/private.zsh"
if [[ ! -e "$migrations/002-private-environment" ]]; then
  if [[ -r "$root/zshrc/private.sh" && ! -e "$private_file" ]]; then
    install -m 0600 "$root/zshrc/private.sh" "$private_file"
    unlink "$root/zshrc/private.sh"
    rmdir "$root/zshrc" 2>/dev/null || true
    echo "Migrated the legacy private shell environment without printing its contents."
  elif [[ ! -e "$private_file" ]]; then
    install -m 0600 /dev/null "$private_file"
  fi
  touch "$migrations/002-private-environment"
fi
chmod 0600 "$private_file" "$config_dir/aliases.local.zsh"

paths_file="$config_dir/paths.env"
if [[ ! -e "$paths_file" ]]; then
  printf 'NOTES_DIR=%q\nPROJECTS_DIR=%q\n' "$HOME/notes" "$HOME/dev" > "$paths_file"
  chmod 0600 "$paths_file"
fi
if ! grep -q '^PROJECTS_DIR=' "$paths_file"; then
  printf 'PROJECTS_DIR=%q\n' "$HOME/dev" >> "$paths_file"
fi
# shellcheck disable=SC1090
source "$paths_file"
mkdir -p "${NOTES_DIR:-$HOME/notes}/raw/meetings"

git_local="$config_dir/git.local"
if [[ ! -e "$git_local" ]]; then
  install -m 0600 /dev/null "$git_local"
fi
if ! git config --file "$git_local" user.name >/dev/null || ! git config --file "$git_local" user.email >/dev/null; then
  if [[ ${DOTFILES_YES:-0} != 1 && -t 0 ]]; then
    read -r -p "Git author name (leave blank to configure later): " git_name
    if [[ -n "$git_name" ]]; then
      read -r -p "Git author email: " git_email
      [[ -n "$git_email" ]] && git config --file "$git_local" user.name "$git_name"
      [[ -n "$git_email" ]] && git config --file "$git_local" user.email "$git_email"
    fi
  else
    echo "Git identity is not configured. Add it to $git_local when ready."
  fi
fi

git -C "$root" config core.hooksPath .githooks
mise trust "$HOME/.config/mise/config.toml" >/dev/null

antidote="$HOME/.local/share/antidote/antidote.zsh"
if [[ -r "$antidote" ]]; then
  zsh -c 'source "$1"; antidote bundle < "$2" > "$3"' -- \
    "$antidote" "$root/zsh/zsh_plugins.txt" "$cache_dir/antidote/zsh_plugins.zsh"
fi

if [[ ! -e "$migrations/003-atuin-history" && -s "$HOME/.zsh_history" ]]; then
  if [[ ${DOTFILES_YES:-0} != 1 && -t 0 ]]; then
    read -r -p "Import the existing Zsh history into Atuin? [Y/n] " import_history
    if [[ ! "$import_history" =~ ^[Nn]$ ]]; then
      atuin import zsh
      touch "$migrations/003-atuin-history"
    fi
  else
    echo "Atuin history import is available: atuin import zsh"
  fi
fi

if [[ -f "$root/claude/scripts/package-lock.json" ]]; then
  npm ci --prefix "$root/claude/scripts"
fi

if [[ "$(uname -s)" == Darwin ]]; then
  applications="$HOME/Applications"
  mkdir -p "$applications"
  aerospace_root="$(mise where github:nikitabobko/AeroSpace 2>/dev/null || true)"
  aerospace_app="$(find "$aerospace_root" -maxdepth 3 -name AeroSpace.app -print -quit 2>/dev/null || true)"
  if [[ -n "$aerospace_app" ]]; then
    ln -sfn "$aerospace_app" "$applications/AeroSpace.app"
  fi

  font_repo="$HOME/.local/share/sketchybar-app-font"
  font_target="$HOME/Library/Fonts/sketchybar-app-font.ttf"
  font_marker="$migrations/004-sketchybar-app-font"
  font_revision="$(git -C "$font_repo" rev-parse HEAD 2>/dev/null || true)"
  installed_revision="$(cat "$font_marker" 2>/dev/null || true)"
  if [[ -n "$font_revision" && "$installed_revision" != "$font_revision" ]]; then
    pnpm --dir "$font_repo" install --frozen-lockfile
    pnpm --dir "$font_repo" run build
    install -m 0644 "$font_repo/dist/sketchybar-app-font.ttf" "$font_target"
    printf '%s\n' "$font_revision" > "$font_marker"
  fi

  defaults_marker="$migrations/005-macos-defaults-restart"
  defaults_revision="$(shasum -a 256 "$root/mise.macos.toml" | awk '{print $1}')"
  restarted_revision="$(cat "$defaults_marker" 2>/dev/null || true)"
  if [[ "$restarted_revision" != "$defaults_revision" ]]; then
    if [[ ${DOTFILES_YES:-0} != 1 && -t 0 ]]; then
      read -r -p "Restart Dock, Finder, and SystemUIServer to load the managed defaults? [Y/n] " restart_apps
      if [[ ! "$restart_apps" =~ ^[Nn]$ ]]; then
        killall Dock 2>/dev/null || true
        killall Finder 2>/dev/null || true
        killall SystemUIServer 2>/dev/null || true
        printf '%s\n' "$defaults_revision" > "$defaults_marker"
      fi
    else
      echo "Log out or restart Dock, Finder, and SystemUIServer to load all macOS defaults."
    fi
  fi
fi

# vim.pack and Tree-sitter both converge during headless startup.
nvim --headless '+qa' </dev/null
