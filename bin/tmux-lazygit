#!/usr/bin/env bash
set -euo pipefail

# Find an existing lazygit pane in the CURRENT session only, so every tmux
# session keeps its own lazygit instance. `-s` scopes the search to the current
# session; `-a` (all sessions) would jump the client into another session's
# lazygit. The pane is tagged with the title "lazygit" when created below.
pane="$(tmux list-panes -s -F '#{pane_title}:#{window_index}.#{pane_index}' | awk -F: '$1 == "lazygit" {print $2; exit}')"

if [[ -z "$pane" ]]; then
  tmux new-window -c "#{pane_current_path}" -n lazygit "zsh -i -c lazygit"
  tmux select-pane -T lazygit
else
  tmux select-window -t "${pane%.*}"
  tmux select-pane -t "$pane"
fi
