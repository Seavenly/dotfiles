#!/usr/bin/env bash
set -euo pipefail

# tmux hotkey (prefix + r): pick a recorded tuicr review - a feature-flow job or
# anything added via `tuicr-reviews add` - and open it in its own worktree with
# `tuicr -r base..branch`. Reviews come from the tuicr-reviews registry, so this
# is cross-repo. Reopening one reuses its window (keyed by worktree + revset).
#
# In the picker: Enter opens the review; ctrl-a toggles its "approved" flag so
# `tuicr-reviews list --approved` can drive a later merge. The status column
# shows ● for an already-open review window and ✓ for an approved one.
#
# Runs inside a `tmux display-popup` (fzf needs a TTY). `--lines` prints the
# composed picker rows (used by fzf's reload after a toggle).

reviews_bin="tuicr-reviews"
command -v "$reviews_bin" >/dev/null 2>&1 || reviews_bin="$HOME/.local/bin/tuicr-reviews"
self="$(command -v tmux-tuicr-reviews 2>/dev/null || printf '%s' "$0")"

# Compose the picker rows. Registry TSV: worktree base branch repo slug created
# summary approved. Display = 2-char status (● open, ✓ approved) + aligned repo,
# base, branch (PR) columns + summary; trailing tab columns carry machine fields.
build_lines() {
  local reviews; reviews="$("$reviews_bin" list 2>/dev/null)"
  [[ -z "$reviews" ]] && return 0
  {
    tmux list-windows -F '#{@tuicr_wt}'$'\t''#{@tuicr_rev}' 2>/dev/null \
      | awk -F'\t' '$1 != "" { print "O\t" $1 "\t" $2 }'
    printf '%s\n' "$reviews" | awk -F'\t' '{ print "R\t" $0 }'
  } | awk -F'\t' -v gap="    " '
      function emit(i,   disp) {
        disp = sprintf("%s%s %-*s", (openrow[i] ? "●" : " "), (appr[i] ? "✓" : " "), wrepo, reponame[i]) gap sprintf("%-*s", wbase, base[i]) gap sprintf("%-*s", wbranch, branch[i])
        if (summary[i] != "") disp = disp gap summary[i]
        printf "%s\t%s\t%s\t%s\n", disp, wt[i], base[i], branch[i]
      }
      $1 == "O" { isopen[$2 SUBSEP $3] = 1; next }
      {
        n++
        wt[n]=$2; base[n]=$3; branch[n]=$4; summary[n]=$8; appr[n]=($9 == "true")
        m = split($5, p, "/"); reponame[n] = p[m]
        rev = $3 ".." $4
        openrow[n] = (isopen[$2 SUBSEP rev] ? 1 : 0)
        if (length(reponame[n]) > wrepo)   wrepo = length(reponame[n])
        if (length($3) > wbase)            wbase = length($3)
        if (length($4) > wbranch)          wbranch = length($4)
      }
      END {
        for (i = 1; i <= n; i++) if (openrow[i])  emit(i)   # open reviews first
        for (i = 1; i <= n; i++) if (!openrow[i]) emit(i)
      }
    '
}

if [[ "${1:-}" == "--lines" ]]; then
  build_lines
  exit 0
fi

lines="$(build_lines)"
if [[ -z "$lines" ]]; then
  echo "No recorded reviews yet. Finish a feature-flow job, or run 'tuicr-reviews add'." >&2
  sleep 2
  exit 0
fi

selection="$(
  printf '%s\n' "$lines" | fzf --no-preview --reverse --delimiter=$'\t' --with-nth=1 --nth=1 \
    --prompt="tuicr review > " \
    --header="enter: open   ctrl-a: toggle approved (✓)" \
    --bind "ctrl-a:execute-silent($reviews_bin toggle-approved --worktree {2} --base {3} --branch {4})+reload($self --lines)"
)" || exit 0
[[ -z "$selection" ]] && exit 0

worktree="$(printf '%s' "$selection" | cut -f2)"
base="$(printf '%s' "$selection" | cut -f3)"
branch="$(printf '%s' "$selection" | cut -f4)"
if [[ -z "$worktree" || ! -d "$worktree" ]]; then
  echo "tmux-tuicr-reviews: worktree is missing: $worktree" >&2
  sleep 2
  exit 0
fi
revset="${base}..${branch}"

# Reuse this review's window (same worktree + revset) if open; else open + tag.
existing="$(tmux list-windows -F '#{window_index}'$'\t''#{@tuicr_wt}'$'\t''#{@tuicr_rev}' \
  | awk -F'\t' -v w="$worktree" -v r="$revset" '$2 == w && $3 == r { print $1; exit }')"

if [[ -n "$existing" ]]; then
  tmux select-window -t ":$existing"
else
  idx="$(tmux new-window -P -F '#{window_index}' -c "$worktree" -n "tuicr:${branch}" \
    "zsh -i -c 'tuicr -r \"${revset}\"'")"
  tmux set-option -w -t ":$idx" @tuicr_wt "$worktree"
  tmux set-option -w -t ":$idx" @tuicr_rev "$revset"
fi
