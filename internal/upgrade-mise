#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=internal/shell/context.sh
source "$root/internal/shell/context.sh"
dotfiles_context_init "$root" || true
if [[ "$DOTFILES_OS" == Darwin ]]; then
  cutoff="$(date -u -v-7d '+%Y-%m-%dT%H:%M:%SZ')"
else
  cutoff="$(date -u -d '7 days ago' '+%Y-%m-%dT%H:%M:%SZ')"
fi

release_json="$(curl --fail --location --silent --show-error 'https://api.github.com/repos/jdx/mise/releases?per_page=100')"
tag="$(jq -r --arg cutoff "$cutoff" '[.[] | select(.draft == false and .prerelease == false and .published_at <= $cutoff)][0].tag_name // empty' <<<"$release_json")"
[[ -n "$tag" ]] || { echo "No eligible mise release found." >&2; exit 1; }
version="${tag#v}"
current_version="$(mise --version | awk '{print $1}')"
IFS=. read -r current_year current_month current_patch <<< "$current_version"
IFS=. read -r next_year next_month next_patch <<< "$version"
if ((next_year < current_year ||
     (next_year == current_year && next_month < current_month) ||
     (next_year == current_year && next_month == current_month && next_patch <= current_patch))); then
  echo "mise $current_version is already at or newer than the latest release eligible under the seven-day policy."
  exit 0
fi
sums="$(curl --fail --location --silent --show-error "https://github.com/jdx/mise/releases/download/${tag}/SHASUMS256.txt")"

sha_for() { awk -v file="./mise-v${version}-$1" '$2 == file {print $1}' <<<"$sums"; }
export MISE_UPGRADE_VERSION="$version"
MISE_UPGRADE_MAC_SHA="$(sha_for macos-arm64)"
MISE_UPGRADE_LINUX_X64_SHA="$(sha_for linux-x64)"
MISE_UPGRADE_LINUX_ARM64_SHA="$(sha_for linux-arm64)"
export MISE_UPGRADE_MAC_SHA MISE_UPGRADE_LINUX_X64_SHA MISE_UPGRADE_LINUX_ARM64_SHA
[[ -n "$MISE_UPGRADE_MAC_SHA" && -n "$MISE_UPGRADE_LINUX_X64_SHA" && -n "$MISE_UPGRADE_LINUX_ARM64_SHA" ]] || {
  echo "The official checksum manifest did not contain all supported targets." >&2
  exit 1
}

perl -0pi -e '
  s/readonly MISE_VERSION="[^"]+"/readonly MISE_VERSION="$ENV{MISE_UPGRADE_VERSION}"/;
  s/(Darwin:arm64\).*?expected_sha=")[^"]+/${1}$ENV{MISE_UPGRADE_MAC_SHA}/s;
  s/(Linux:x86_64\).*?expected_sha=")[^"]+/${1}$ENV{MISE_UPGRADE_LINUX_X64_SHA}/s;
  s/(Linux:aarch64\|Linux:arm64\).*?expected_sha=")[^"]+/${1}$ENV{MISE_UPGRADE_LINUX_ARM64_SHA}/s;
' "$root/internal/commands/install"
perl -pi -e 's/^min_version = "[^"]+"/min_version = "$ENV{MISE_UPGRADE_VERSION}"/' "$root/mise.toml"

MISE_LOCKED=0 mise self-update --yes --no-plugins "$version"
echo "mise $version is installed; review internal/commands/install and mise.toml."
