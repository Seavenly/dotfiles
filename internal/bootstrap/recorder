#!/usr/bin/env bash
set -euo pipefail

root="${DOTFILES_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
# shellcheck source=internal/shell/context.sh
source "$root/internal/shell/context.sh"
# shellcheck source=internal/shell/paths.sh
source "$root/internal/shell/paths.sh"
dotfiles_context_init "$root" || true
dotfiles_load_paths
[[ "$DOTFILES_OS" == Darwin ]] || { echo "Recorder setup is macOS-only." >&2; exit 1; }

export UV_PROJECT_ENVIRONMENT="$DOTFILES_DATA_DIR/recorder-venv"
uv sync --project "$root/tools/recorder" --frozen
mkdir -p "$NOTES_DIR/raw/meetings"

cat <<'EOF'
Recorder installed. Manual prerequisites remain:
  1. Create a Multi-Output Device containing your speakers and BlackHole 2ch.
  2. Accept the pyannote speaker-diarization-community-1 license.
  3. Run: rec auth
See tools/recorder/README.md for details.
EOF
