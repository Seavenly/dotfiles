#!/usr/bin/env bash
set -euo pipefail

root="${DOTFILES_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
# shellcheck source=internal/shell/context.sh
source "$root/internal/shell/context.sh"
dotfiles_context_init "$root" || true
[[ "$DOTFILES_OS" == Darwin ]] || exit 0
screenshot_dir="$HOME/Pictures/Screenshots"
mkdir -p "$screenshot_dir"
current="$(defaults read com.apple.screencapture location 2>/dev/null || true)"
if [[ "$current" != "$screenshot_dir" ]]; then
  defaults write com.apple.screencapture location -string "$screenshot_dir"
fi
