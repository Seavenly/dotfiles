#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$(uname -s):$(uname -m)" in
  Darwin:arm64) env_name=macos ;;
  Linux:x86_64|Linux:aarch64|Linux:arm64) env_name=linux ;;
  *) echo "Unsupported platform." >&2; exit 1 ;;
esac
export MISE_TRUSTED_CONFIG_PATHS="$root"
export MISE_LOCKED=0

upgrade_tools() {
  mise lock -C "$root" -E "$env_name" --platform macos-arm64,linux-x64,linux-arm64 --minimum-release-age 7d
  MISE_LOCKED=1 mise install -C "$root" -E "$env_name"
}
upgrade_packages() {
  mise bootstrap packages upgrade -C "$root" -E "$env_name"
  [[ "$env_name" != macos ]] || "$root/bin/bootstrap-macos-casks"
}
upgrade_shell() {
  mise bootstrap repos apply -C "$root" -E "$env_name"
  "$root/bin/bootstrap-finalize"
  echo "Shell repos are commit-pinned; update their refs deliberately in mise.toml/zsh_plugins.txt."
}
upgrade_nvim() { nvim --headless '+lua vim.pack.update()' '+qa'; }
upgrade_recorder() {
  [[ "$(uname -s)" == Darwin ]] || { echo "Recorder is macOS-only." >&2; return 1; }
  "$root/bin/bootstrap-macos-casks" --recorder-only
  export UV_PROJECT_ENVIRONMENT="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/recorder-venv"
  uv lock --project "$root/tools/recorder" --upgrade
  uv sync --project "$root/tools/recorder" --frozen
}
upgrade_mise() {
  "$root/bin/upgrade-mise"
}

components=("${@:-all}")
if [[ ${components[0]} == all ]]; then
  components=(tools packages shell nvim)
  [[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/recorder-venv" ]] && components+=(recorder)
fi
for component in "${components[@]}"; do
  echo "==> upgrading $component"
  case "$component" in
    mise) upgrade_mise ;;
    tools) upgrade_tools ;;
    packages) upgrade_packages ;;
    shell) upgrade_shell ;;
    nvim) upgrade_nvim ;;
    recorder) upgrade_recorder ;;
    *) echo "Unknown component: $component" >&2; exit 2 ;;
  esac
done
